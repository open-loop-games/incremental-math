---
import { cite, type CiteRef } from '../lib/cite';
const props = Astro.props as CiteRef;
const r = cite(props);
---

{
  r.url ? (
    <a class="cite" href={r.url} target="_blank" rel="noopener noreferrer">
      <code>{r.display}</code>
    </a>
  ) : r.local ? (
    <code class="cite cite-local" title="In-corpus source with no hosted upstream">
      {r.display}
    </code>
  ) : (
    <code
      class="cite cite-unresolved"
      title="Citation could not be resolved against a known submodule"
    >
      {r.display}
    </code>
  )
}
