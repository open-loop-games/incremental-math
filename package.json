{
  "name": "incremental-math",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-cite-meta.js",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "oxlint src/",
    "format": "oxfmt src && prettier --write \"src/**/*.astro\"",
    "format:check": "oxfmt --check src && prettier --check \"src/**/*.astro\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,css,html,json,md}": "oxfmt --no-error-on-unmatched-pattern",
    "*.astro": "prettier --write",
    "*.{ts,vue}": "oxlint --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/vue": "^5.1.0",
    "astro": "^5.16.0",
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "uplot": "^1.6.32",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "husky": "^9.1.7",
    "katex": "^0.16.45",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.85.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.6.0"
}
