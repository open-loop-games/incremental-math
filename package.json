{
  "name": "incremental-math",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/gen-cite-meta.js",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,vue,astro,css,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,astro,css,html,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,astro,css,html,json,md}": "prettier --write",
    "*.{ts,vue}": "eslint --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/vue": "^5.1.0",
    "astro": "^5.16.0",
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "uplot": "^1.6.32",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "katex": "^0.16.45",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0"
  }
}
